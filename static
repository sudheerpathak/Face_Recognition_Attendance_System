:root {
  --bg: #f1f3f9;
  --surface: #ffffff;
  --text: #1e293b;
  --muted: #64748b;
  --border: #e5e7eb;
  --primary: #4f46e5;
  --primary-dark: #4338ca;
  --green: #16a34a;
  --green-bg: #dcfce7;
  --blue-bg: #e0e7ff;
}

* { box-sizing: border-box; }

body {
  font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  margin: 0;
  background: var(--bg);
  color: var(--text);
}

/* Navbar */
.navbar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 14px 32px;
  display: flex;
  gap: 24px;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 10;
}
.navbar .brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  color: var(--text);
  text-decoration: none;
  margin-right: auto;
}
.navbar .brand svg { width: 22px; height: 22px; color: var(--primary); }
.nav-links { display: flex; gap: 24px; }
.nav-links a { color: var(--muted); text-decoration: none; font-weight: 500; font-size: .95rem; }
.nav-links a:hover { color: var(--primary); }

.container { max-width: 900px; margin: 0 auto; padding: 32px 20px 64px; }

/* Hero */
.hero { margin-bottom: 28px; }
.hero h1 { margin: 0 0 6px; font-size: 1.9rem; }
.hero .subtitle { margin: 0; color: var(--muted); font-size: 1.02rem; }

/* Stats */
.stats { display: flex; gap: 16px; margin-bottom: 28px; }
.stat-card {
  background: var(--surface);
  border-radius: 12px;
  padding: 20px;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14px;
  box-shadow: 0 1px 3px rgba(0,0,0,.06);
}
.stat-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.stat-icon svg { width: 22px; height: 22px; }
.stat-icon--blue { background: var(--blue-bg); color: var(--primary); }
.stat-icon--green { background: var(--green-bg); color: var(--green); }
.stat-number { display: block; font-size: 1.6rem; font-weight: 700; line-height: 1.2; }
.stat-label { display: block; color: var(--muted); font-size: .85rem; }

/* Action cards */
.action-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 32px; }
.action-card {
  background: var(--surface);
  border-radius: 12px;
  padding: 20px;
  text-decoration: none;
  color: var(--text);
  box-shadow: 0 1px 3px rgba(0,0,0,.06);
  transition: transform .15s ease, box-shadow .15s ease;
}
.action-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(79,70,229,.15); }
.action-icon { width: 40px; height: 40px; border-radius: 10px; background: var(--blue-bg); color: var(--primary); display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
.action-icon svg { width: 20px; height: 20px; }
.action-card h3 { margin: 0 0 4px; font-size: 1.05rem; }
.action-card p { margin: 0; color: var(--muted); font-size: .88rem; }

/* Recent / generic sections */
.recent h2, .container > h1 { margin-bottom: 12px; }
.empty-state { color: var(--muted); background: var(--surface); border-radius: 10px; padding: 20px; text-align: center; }

/* Buttons */
.actions { display: flex; gap: 12px; margin: 16px 0; flex-wrap: wrap; }
.button, button {
  background: var(--primary);
  color: #fff;
  border: none;
  padding: 10px 18px;
  border-radius: 8px;
  cursor: pointer;
  text-decoration: none;
  font-size: .95rem;
  font-weight: 500;
  display: inline-block;
}
.button:hover, button:hover { background: var(--primary-dark); }

/* Forms */
form label { display: block; margin: 14px 0; font-size: .9rem; font-weight: 500; color: var(--muted); }
.filter-form { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.filter-form label { display: flex; align-items: center; gap: 8px; margin: 0; }
.filter-form input { display: inline-block; margin-top: 0; }
input[type=text], input[type=date], input[type=password] {
  display: block;
  margin-top: 6px;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  width: 100%;
  max-width: 280px;
  font-size: .95rem;
}

/* Tables */
table { width: 100%; border-collapse: collapse; margin-top: 12px; background: var(--surface); border-radius: 10px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
th, td { padding: 10px 14px; border-bottom: 1px solid var(--border); text-align: left; font-size: .92rem; }
th { color: var(--muted); font-weight: 600; background: #f8fafc; }
tr:last-child td { border-bottom: none; }

/* Video */
.video-wrapper { width: 100%; max-width: 640px; margin: 16px 0; }
img#video {
  width: 100%;
  border-radius: 12px;
  background: #000;
  display: block;
  min-height: 240px;
}
.video-placeholder {
  width: 100%;
  min-height: 240px;
  border-radius: 12px;
  background: #0f172a;
  color: #94a3b8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 1px dashed #334155;
}
.video-placeholder svg { width: 40px; height: 40px; opacity: .6; }
.video-placeholder p { margin: 0; font-size: .9rem; }

#message { color: var(--green); font-weight: 500; }

@media (max-width: 640px) {
  .action-grid { grid-template-columns: 1fr; }
  .stats { flex-direction: column; }
  .nav-links { gap: 14px; }
}

/* Login screen */
.login-screen {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
}
.login-card {
  background: var(--surface);
  border-radius: 14px;
  padding: 36px 32px;
  width: 100%;
  max-width: 340px;
  box-shadow: 0 4px 16px rgba(0,0,0,.08);
  text-align: center;
}
.login-icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--blue-bg);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
}
.login-icon svg { width: 26px; height: 26px; }
.login-card h1 { font-size: 1.3rem; margin: 0 0 4px; }
.login-card .subtitle { margin: 0 0 20px; }
.login-card label { text-align: left; }
.login-card input { max-width: none; }
.login-card button { width: 100%; margin-top: 8px; }
.login-card .error { color: #dc2626; background: #fee2e2; padding: 8px 12px; border-radius: 8px; font-size: .88rem; margin: -4px 0 16px; }
